    <string name="a4k_recommended">Recommended for this phone: %1$s</string>
    <string name="a4k_recommended_off">Recommended for this phone: off. It does not have the headroom to run Anime4K without dropping frames.</string>
    <string name="a4k_apply">Apply</string>
    <string name="a4k_mode_a">For HD anime (720p/1080p) that looks blurry or blocky: cleans compression artefacts and sharpens the lines.</string>
    <string name="a4k_mode_b">For HD anime with only light blur: a softer restore that keeps the original line art.</string>
    <string name="a4k_mode_c">For low-resolution or noisy video (480p and below): removes noise and enlarges. The lightest mode.</string>
    <string name="a4k_mode_a_plus">A stronger A that restores twice. Heavy: flagship phones only.</string>
    <string name="a4k_mode_b_plus">A stronger B. Heavy: flagship phones only.</string>
    <string name="a4k_mode_c_plus">For very poor sources: removes noise, then restores. Heavy.</string>
    <string name="a4k_quality_info">Fast uses the smallest network and costs almost nothing; High looks best but can drop frames on most phones.</string>
    <string name="a4k_check">Check dropped frames</string>
    <string name="a4k_checking">Measuring for %1$d s… keep the video playing</string>
    <string name="a4k_check_smooth">Smooth: no dropped frames in %1$d s.</string>
    <string name="a4k_check_drops">%1$d frames dropped and %2$d late in %3$d s. Switched to a lighter setting; check again.</string>
    <string name="a4k_check_drops_min">%1$d frames dropped in %2$d s even at the lightest setting. Anime4K was turned off for smooth playback.</string>

    <string name="glass_safe_mode">Safe mode is on: glass effects are off</string>
    <string name="glass_safe_mode_summary">It was turned on from the crash report. Tap to turn it off and restart the screen.</string>

    <string name="smooth_title">Smoothness</string>
    <string name="smooth_match">Match screen to video</string>
    <string name="smooth_match_summary">Asks the screen for a refresh rate that fits the video's frame rate (e.g. 24 fps on 120 Hz), removing judder at no cost. Android 11+.</string>
    <string name="smooth_motion">Smooth motion</string>
    <string name="smooth_motion_summary">Blends frames to the screen's refresh rate. Smoothest on 60 Hz screens; uses a little more GPU. Applies from the next video.</string>
    <string name="smooth_auto">Auto</string>
    <string name="smooth_quality">Image quality</string>
    <string name="smooth_quality_fast">Fast</string>
    <string name="smooth_quality_balanced">Balanced</string>
    <string name="smooth_quality_high">Max</string>
    <string name="smooth_quality_fast_summary">Simple scaling. Lightest on the GPU, never drops frames, slightly softer picture.</string>
    <string name="smooth_quality_balanced_summary">Sharp scaling with clean downscaling. Good picture at a small GPU cost.</string>
    <string name="smooth_quality_high_summary">Sharpest scaling (Lanczos) with smooth edges. Best picture; for strong phones.</string>
    <string name="smooth_buffer">Bigger buffer</string>
    <string name="smooth_buffer_summary">Loads up to two minutes ahead so slow or unstable connections do not pause playback. Uses more memory. Applies from the next video.</string>
    <string name="smooth_glass_rate">Glass refresh</string>
    <string name="smooth_glass_rate_summary">How often the glass controls follow the video. 30 fps is smooth and light; Off turns the live glass off for maximum performance.</string>
    <string name="player_button_look">Button size and spacing</string>
    <string name="player_button_size">Button size</string>
    <string name="player_button_spacing">Space between buttons</string>
    <string name="player_button_reset">Reset</string>
    <string name="smooth_off">Off</string>
    <string name="smooth_decoder_drop">Keep sync on weak phones</string>
    <string name="smooth_decoder_drop_summary">When the phone falls behind, frames are skipped early in the decoder so audio and video stay together instead of stuttering.</string>
    <string name="smooth_fast_decode">Fast decoding</string>
    <string name="smooth_fast_decode_summary">Lighter software decoding (skips the loop filter on non-reference frames). For phones without hardware decoding; tiny quality loss. Applies from the next video.</string>
    <string name="smooth_fast_seek">Fast seeking</string>
    <string name="smooth_fast_seek_summary">Jumps to the nearest keyframe instantly instead of the exact frame. Seeking feels immediate.</string>
    <string name="smooth_stats">Frame counter</string>
    <string name="smooth_stats_summary">Shows dropped (VO, DEC) and late frames in the corner, to check that playback is smooth.</string>
    <string name="quality_title">Quality</string>
    <string name="quality_antiring">Reduce halos</string>
    <string name="quality_antiring_summary">Softens the light halos sharp scaling leaves around lines and subtitles.</string>
    <string name="quality_dither">Smooth gradients</string>
    <string name="quality_dither_summary">Dithering hides colour banding in skies and dark scenes at almost no cost.</string>
    <string name="quality_deinterlace">Deinterlace</string>
    <string name="quality_deinterlace_summary">Removes comb lines from interlaced DVD or broadcast sources. Leave off for normal anime.</string>
    <string name="quality_tone_mapping">HDR tone mapping</string>
    <string name="quality_tone_mapping_summary">How HDR video is fitted to the screen. Auto is best for most; Hable is punchier, Mobius keeps more colour.</string>
    <string name="optimizer_title">Smart optimizer</string>
    <string name="optimizer_enabled">Optimize every video</string>
    <string name="optimizer_enabled_summary">Checks each new video and this phone and keeps everything at the video\'s own frame rate: the screen switches to that rate or an exact multiple when it can, and image quality and effects are chosen so no frames drop. On-device rules and measurements, no internet.</string>
    <string name="optimizer_waiting">Waiting for the video to start…</string>
    <string name="optimizer_video">Video: %1$s fps • %2$s • %3$s (%4$s)</string>
    <string name="optimizer_decoder_hardware">hardware decoding</string>
    <string name="optimizer_decoder_software">software decoding</string>
    <string name="optimizer_cadence_exact">Screen at %1$d Hz: every video frame stays exactly %2$d refreshes. Perfect cadence, no judder.</string>
    <string name="optimizer_cadence_uneven">Screen at %1$d Hz: this phone has no exact multiple of this video, so the video keeps its own frame rate and the screen is left alone.</string>
    <string name="optimizer_device">This phone: %1$s.</string>
    <string name="optimizer_tier_low">entry level, lightest settings</string>
    <string name="optimizer_tier_mid">mid-range</string>
    <string name="optimizer_tier_high">high-end</string>
    <string name="optimizer_tier_flagship">flagship, maximum quality</string>
    <string name="optimizer_saver_active">Battery saver or low battery: lighter plan until you charge.</string>
    <string name="optimizer_refresh">Screen refresh rate</string>
    <string name="optimizer_refresh_summary">✦ marks the recommendation: the video\'s own rate or the closest exact multiple the screen supports.</string>
    <string name="optimizer_sync">Frame pacing</string>
    <string name="optimizer_sync_summary">Video fps shows every frame at the episode\'s original timing (recommended). Locked fits the video to the screen; Locked + smooth also blends frames and costs more.</string>
    <string name="optimizer_sync_audio">Video fps</string>
    <string name="optimizer_sync_locked">Locked to screen</string>
    <string name="optimizer_sync_smooth">Locked + smooth</string>
    <string name="optimizer_quality_summary">Chosen from the video\'s pixels per second and this phone\'s power.</string>
    <string name="optimizer_glass_summary">Live glass on the controls costs a little GPU; lower on weaker phones.</string>
    <string name="optimizer_adjusted">Frames were dropping, so this video was adjusted automatically: %1$s.</string>
    <string name="optimizer_step_quality">lighter scaling</string>
    <string name="optimizer_step_glass">live glass off</string>
    <string name="optimizer_step_interpolation">frame blending off</string>
    <string name="optimizer_adaptive">Fix stutters automatically</string>
    <string name="optimizer_adaptive_summary">Watches the dropped-frame counters while you watch and steps down one level at a time if the phone falls behind.</string>
    <string name="optimizer_battery">Save battery when low</string>
    <string name="optimizer_battery_summary">On battery saver or below 15%, uses a lighter plan.</string>
    <string name="optimizer_mode_switch">Allow any refresh switch</string>
    <string name="optimizer_mode_switch_summary">Lets the screen change refresh rate even when the switch blanks it for a moment (Android 12+). Turn on if your phone ignores seamless switches.</string>
